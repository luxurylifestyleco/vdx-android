<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Android 11+ package visibility: without these <queries> entries,
         SpeechRecognizer.isRecognitionAvailable() returns false and the
         ACTION_CALL intent can't be resolved — the mic "never returns text"
         and the dialer never starts. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CALL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:name=".VdxApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VDX"
        tools:targetApi="34">

        <!-- D-fix (device crash): sentry-android auto-installs SentryInitProvider which
             throws 'DSN is required' at app start when no DSN is configured. The app
             ships its own privacy-clean Telemetry; disable Sentry auto-init until the
             team deliberately wires a DSN (then also set a real DSN). -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />
        <meta-data android:name="io.sentry.enabled" android:value="false" />

        <activity
            android:name="com.vdx.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bubble overlay — foreground service, works WITHOUT accessibility.
             Type = microphone (REQUIRED for SpeechRecognizer on Android 11+).
             On Android 11+ a SpeechRecognizer started from a service that is NOT
             a foreground service with microphone type returns error 9
             (ERROR_INSUFFICIENT_PERMISSIONS) even with RECORD_AUDIO granted —
             the mic "never returns text". FOREGROUND_SERVICE_MICROPHONE is
             declared above; RECORD_AUDIO is granted at recognition time. -->
        <service
            android:name="com.vdx.BubbleForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Accessibility service — base service: layout retrieval + view operations.
             Does NOT declare canPerformGestures, so it avoids the system lag / frame
             drops that a gesture-capable accessibility service can cause. -->
        <service
            android:name="com.vdx.VdxAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Accessibility service — gesture-only: tap / swipe / scroll dispatch.
             Declares canPerformGestures=true and does no tree work, keeping it
             lightweight so it never contributes to system jank. -->
        <service
            android:name="com.vdx.GestureAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/gesture_accessibility_config" />
        </service>

        <!-- Debug-only intent hook. Not exported — VDX is a phone app, not
             an Agent OS control plane. Same-app / adb only. -->
        <receiver
            android:name="com.vdx.ExternalAutomationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.vdx.action.RUN_TASK" />
                <action android:name="com.vdx.action.RUN_CHAT" />
            </intent-filter>
        </receiver>

    </application>
</manifest>