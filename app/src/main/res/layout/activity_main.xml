<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/title_vdx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="VDX"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="#6c3aed" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Say it. VDX taps it.\nCalls, chats, rides — hands-free."
            android:textSize="16sp"
            android:textColor="#1a1a2e" />

        <EditText
            android:id="@+id/text_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Try call Mom, WhatsApp, Uber…"
            android:textColor="#1a1a2e"
            android:textColorHint="#8a8a8e"
            android:background="#ffffff"
            android:padding="14dp"
            android:textSize="16sp"
            android:inputType="text"
            android:imeOptions="actionSend" />

        <LinearLayout
            android:id="@+id/suggest_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="16dp"
            android:background="#ffffff"
            android:textColor="#1a1a2e"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:text="Setup" />

        <TextView
            android:id="@+id/permission_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:textColor="#f59e0b"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_action"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="#6c3aed"
            android:textColor="#ffffff"
            android:text="Grant Microphone"
            android:textSize="16sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_accessibility"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="#e0e0e0"
            android:textColor="#1a1a2e"
            android:text="Turn on VDX in Accessibility"
            android:textSize="14sp"
            android:textAllCaps="false" />

        <LinearLayout
            android:id="@+id/labs_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Labs"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#6c3aed"
                android:padding="8dp"
                android:background="#f0edff" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <Button android:id="@+id/btn_test_youtube" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="YouTube" android:textAllCaps="false" android:textSize="12sp" />
                <Button android:id="@+id/btn_test_dialer" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Dialer" android:textAllCaps="false" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/btn_test_settings" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="Settings" android:textAllCaps="false" android:textSize="12sp" />
                <Button android:id="@+id/btn_test_readscreen" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Read Screen" android:textAllCaps="false" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/btn_test_readsms" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="Read SMS" android:textAllCaps="false" android:textSize="12sp" />
                <Button android:id="@+id/btn_test_call" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Call" android:textAllCaps="false" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/btn_test_whatsapp" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="WhatsApp" android:textAllCaps="false" android:textSize="12sp" />
                <Button android:id="@+id/btn_test_uber" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Uber" android:textAllCaps="false" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/btn_test_sms" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="SMS" android:textAllCaps="false" android:textSize="12sp" />
                <Button android:id="@+id/btn_test_email" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Email" android:textAllCaps="false" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/btn_test_all" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="Run All" android:textAllCaps="false" android:textSize="12sp" />
                <Button android:id="@+id/btn_clear_log" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Clear" android:textAllCaps="false" android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/harness_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                android:background="#1a1a2e"
                android:textColor="#22c55e"
                android:textSize="11sp"
                android:typeface="monospace"
                android:text="" />

            <!-- BYOK AI keys card — one secure input per provider, validated on save.
                 Keys are stored in the encrypted KeyVault (never plain prefs). -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="AI keys"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#6c3aed"
                android:padding="8dp"
                android:background="#f0edff" />

            <TextView
                android:id="@+id/ai_keys_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Stored encrypted on-device (Android Keystore). Never leaves your phone."
                android:textSize="11sp"
                android:textColor="#8a8a8e"
                android:lineSpacingExtra="2dp" />

            <LinearLayout
                android:id="@+id/ai_keys_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- Accessibility verbosity dial (Labs) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Speech level"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#6c3aed"
                android:padding="8dp"
                android:background="#f0edff" />

            <LinearLayout
                android:id="@+id/speech_level_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />


        </LinearLayout>

        <!-- DEMO DRIVER (outside-request path: Alexa-style) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Demo driver - outside request path"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#6c3aed"
            android:padding="8dp"
            android:background="#f0edff" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Simulates Alexa asking VDX to do something. The request enters the SAME door, passes the SAME safety gates, and returns evidence - success, cancelled, unverified, or blocked."
            android:textSize="11sp"
            android:textColor="#8a8a8e" />

        <EditText
            android:id="@+id/demo_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:hint="e.g. WhatsApp Papa saying I will be late"
            android:textSize="13sp"
            android:inputType="text"
            android:imeOptions="actionSend"
            android:background="#f5f3ff"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_demo_send" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="Send request" android:textAllCaps="false" android:textSize="12sp" />
            <Button android:id="@+id/btn_demo_clear" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Clear evidence" android:textAllCaps="false" android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/demo_evidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="90dp"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="#1a1a2e"
            android:textColor="#e8e2fd"
            android:textSize="11sp"
            android:typeface="monospace"
            android:text="" />

    </LinearLayout>
</ScrollView>
